# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=playlist_user
POSTGRES_PASSWORD=playlist_pass
POSTGRES_DB=playlist_db

# for proper redirects to frontend app
FRONTEND_URL=http://localhost:3000

# ── Security ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_me_with_a_long_random_string

# ── Google / YouTube OAuth ────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# ── Spotify OAuth ─────────────────────────────────────────────────────────────
# Create at: https://developer.spotify.com/dashboard
# Redirect URI: http://localhost:8080/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URL=http://localhost:8080/auth/spotify/callback

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8080
